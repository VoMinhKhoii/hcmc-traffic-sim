split + min(8, crossing − 12)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#1A1A1A;fontSize=11;fontStyle=0;verticalAlign=middle;" vertex="1" parent="cyc"><mxGeometry x="2686" y="218" width="110" height="56" as="geometry"/></mxCell><mxCell id="g4" value="Continue?" style="outlineConnect=0;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=rhombusPerimeter;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;fontSize=11;shape=mxgraph.bpmn.gateway2;outline=none;symbol=none;gwType=exclusive;" vertex="1" parent="cyc"><mxGeometry x="2926" y="533" width="50" height="50" as="geometry"/></mxCell><mxCell id="e1" value="Mode change" style="outlineConnect=0;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;aspect=fixed;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;fontSize=11;shape=mxgraph.bpmn.event;outline=end;symbol=general;" vertex="1" parent="cyc"><mxGeometry x="3141" y="538" width="40" height="40" as="geometry"/></mxCell><mxCell id="__title" value="1/3 · One green — what decides its length" style="text;html=1;align=center;fontStyle=1;fontSize=14;fontColor=light-dark(#232F3E,#E8E8E8);" vertex="1" parent="1"><mxGeometry x="0" y="24" width="3352" height="30" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;A = E + W&lt;/b&gt; &amp;#183; &lt;b&gt;B = N + S&lt;/b&gt; &amp;#8212; never green together; whichever is green, the other is &lt;i&gt;the crossing road&lt;/i&gt;&lt;br&gt;&lt;b&gt;peak cycle 40 s = A + B + 10&lt;/b&gt; &amp;#183; A + B = 30 s of green to share, split by demand&lt;br&gt;&lt;b&gt;yellow 3 s&lt;/b&gt; stopping distance at 40 km/h &amp;#183; &lt;b&gt;all-red 2 s&lt;/b&gt; intersection width &amp;#247; speed &amp;#183; two of each per cycle = the &lt;b&gt;10&lt;/b&gt;&lt;br&gt;&lt;b&gt;min green 12 s = walk min 12 s&lt;/b&gt; = 14 m crossing &amp;#247; 1.2 m/s &amp;#8212; ONE floor, so green length no longer depends on whether a pedestrian is present&lt;br&gt;&lt;b&gt;peak needs no runtime check&lt;/b&gt; &amp;#8212; the split calculation floors every phase at 12 s (30 s of green &amp;#8805; 2 &amp;#215; 12 s)&lt;br&gt;&lt;b&gt;congestion&lt;/b&gt; alarm at &lt;b&gt;25 veh&lt;/b&gt; held &lt;b&gt;20 s&lt;/b&gt; &amp;#183; clears at &lt;b&gt;15&lt;/b&gt; (hysteresis) &amp;#183; the shift is &lt;b&gt;min(8, crossing green &amp;#8722; 12)&lt;/b&gt;, so a phase already at the 12 s floor donates &lt;b&gt;nothing&lt;/b&gt;&lt;br&gt;&lt;b&gt;green moves off plan in exactly two places&lt;/b&gt; &amp;#8212; when central re-times the plan, and when the next green reads that plan at the red&amp;#8594;green boundary &amp;#183; the cycle and the offset never change&lt;br&gt;&lt;b&gt;off-peak alarm&lt;/b&gt; replaces the actuated law with a Webster fixed plan &amp;#8212; gap-out and hold-while-detected stop applying until it clears&lt;br&gt;&lt;b&gt;gap-out&lt;/b&gt; no arrival for 3 s and no queue &amp;#183; &lt;b&gt;max green 40 s&lt;/b&gt; caps how long a &lt;i&gt;waiting&lt;/i&gt; vehicle is held, not the green itself" style="rounded=0;whiteSpace=wrap;align=left;spacingLeft=14;html=1;fillColor=#F5F8FB;strokeColor=#C4CCD7;fontColor=#1A1A1A;fontSize=11;fontStyle=0;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="772" width="3272" height="186" as="geometry"/></mxCell><mxCell id="ed1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;jettySize=auto;orthogonalLoop=1;fontSize=10;fontColor=light-dark(#1B2733,#CFE0F0);strokeColor=light-dark(#1A1A1A,#E0E0E0);strokeWidth=1;flowAnimation=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="tp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;jettySize=auto;orthogonalLoop=1;fontSize=10;fontColor=light-dark(#1B2733,#CFE0F0);strokeColor=light-dark(#1A1A1A,#E0E0E0);strokeWidth=1;flowAnimation=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tp" target="gc1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed3" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;jettySize=auto;orthogonalLoop=1;fontSize=10;fontColor=light-dark(#1B2733,#CFE0F0);strokeColor=light-dark(#1A1A1A,#E0E0E0);strokeWidth=1;flowAnimation=1;labelBackgroundColor=light-dark(#FFFFFF,#0B0F14);exitX=1;exitY=0.34;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gc1" target="cr"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="771" y="214"/><mxPoint x="771" y="222"/></Array></mxGeometry></mxCell><mxCell id="ed4" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;jettySize=auto;orthogonalLoop=1;fontSize=10;fontColor=light-dark(#1B2733,#CFE0F0);strokeColor=light-dark(#1A1A1A,#E0E0E0);strokeWidth=1;labelBackgroundColor=light-dark(#FFFFFF,#0B0F14);exitX=1;exitY=0.66;exitDx=0;exitDy=0;entryX=0;entryY=0.34;entryDx=0;entryDy=0;" edge="1" parent="1" source="gc1" target="g1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="730" y="230"/><mxPoint x="730" y="170"/><mxPoint x="1052" y="170"/><mxPoint x="1052" y="214"/></Array></mxGeometry></mxCell><mxCell id="ed5" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;jettySize=auto;orthogonalLoop=1;fontSize=10;fontColor=light-dark(#1B2733,#CFE0F0);strokeColor=light-dark(#1A1A1A,#E0E0E0);strokeWidth=1;flowAnimation=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.66;entryDx=0;entryDy=0;" edge="1" parent="1" source="cr" target="g1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed6" value="peak" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;jettySize=auto;orthogonalLoop=1;fontSize=10;fontColor=light-dark(#1B2733,#CFE0F0);strokeColor=light-d